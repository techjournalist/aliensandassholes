// Cloudflare Workers static-asset deploy for Aliens & Assholes.
// Serves the repo root as a static site; .assetsignore keeps dev files out.
// The worker name must match the Cloudflare project name.
{
  "name": "aliens-and-assholes",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "." }
}
